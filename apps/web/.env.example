# =============================================================================
# QalNet Web — Environment Variables
# Copy to .env.local for local development.
# NEVER commit real secrets.
# =============================================================================

# ── DEVELOPMENT ──────────────────────────────────────────────────────────────

# Backend API base URL (without the /api/v1 suffix)
# Browser hits /api/proxy which forwards to this backend URL
# Development: http://localhost:4000
# Production: https://api.your-domain.com
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000

# App URL (used for OAuth callbacks, email links, etc.)
# Development: http://localhost:3001
# Production: https://your-domain.com
NEXT_PUBLIC_APP_URL=http://localhost:3001

# Node environment
NODE_ENV=development

# ── PRODUCTION ───────────────────────────────────────────────────────────────
# Uncomment these and set to production values when deploying

# NEXT_PUBLIC_API_BASE_URL=https://api.your-domain.com
# NEXT_PUBLIC_APP_URL=https://your-domain.com
# NODE_ENV=production
