# =============================================================================
# QalNet Web — Environment Variables
# Copy to .env.local for local development.
# NEVER commit real secrets.
# =============================================================================

# Backend API base URL (without the /api/v1 suffix) — Next.js client-side fetch
# The /api/v1 prefix and version are appended by services/api.ts automatically.
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000
# Legacy alias — some modules still read NEXT_PUBLIC_API_URL (full URL incl. /api/v1)
# NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1

# App URL (used for OAuth callbacks, etc.)
NEXT_PUBLIC_APP_URL=http://localhost:3001

NODE_ENV=development
