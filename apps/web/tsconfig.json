{
    "extends": "@qalnet/typescript-config/nextjs.json",
    "compilerOptions": {
        "tsBuildInfoFile": ".next/.tsbuildinfo",
        "paths": {
            "@/*": [
                "./src/*"
            ],
            "@qalnet/shared-types": [
                "../../packages/shared-types/src"
            ]
        }
    },
    "include": [
        "next-env.d.ts",
        "**/*.ts",
        "**/*.tsx",
        ".next/types/**/*.ts",
        ".next/dev/types/**/*.ts"
    ],
    "exclude": [
        "node_modules",
        ".next"
    ]
}