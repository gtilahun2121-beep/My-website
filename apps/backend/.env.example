# =============================================================================
# QalNet Backend — Environment Variables
# Copy this file to .env and fill in values for local development.
# In production, all secrets are loaded from AWS Secrets Manager.
# NEVER commit a real .env file to version control.
# =============================================================================

NODE_ENV=development

# -----------------------------------------------------------------------------
# Database (Neon Serverless Postgres)
# Get this from: https://console.neon.tech → your project → Connection string
# Use the POOLED connection string (has "-pooler" in the hostname)
# -----------------------------------------------------------------------------
DATABASE_URL=postgresql://neondb_owner:<password>@ep-<name>-pooler.<region>.aws.neon.tech/neondb?sslmode=require

# -----------------------------------------------------------------------------
# JWT — RS256 Asymmetric Keys
# Generate with:
#   openssl genrsa -out private.pem 2048
#   openssl rsa -in private.pem -pubout -out public.pem
# Newlines must be escaped as \n when stored in a single-line .env value
# -----------------------------------------------------------------------------
JWT_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\n<base64>\n-----END RSA PRIVATE KEY-----"
JWT_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\n<base64>\n-----END PUBLIC KEY-----"
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# -----------------------------------------------------------------------------
# Argon2id Password Hashing
# -----------------------------------------------------------------------------
ARGON2_PEPPER=change-me-to-a-random-64-char-string

# -----------------------------------------------------------------------------
# Redis
# -----------------------------------------------------------------------------
REDIS_URL=redis://localhost:6379

# -----------------------------------------------------------------------------
# Payment Gateways
# -----------------------------------------------------------------------------
CHAPA_SECRET_KEY=CHASECK_TEST-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TELEBIRR_APP_KEY=your-telebirr-app-key
TELEBIRR_APP_SECRET=your-telebirr-app-secret

# -----------------------------------------------------------------------------
# Encryption
# -----------------------------------------------------------------------------
PGCRYPTO_SYMMETRIC_KEY=change-me-to-a-strong-random-key

# -----------------------------------------------------------------------------
# Admin Bootstrap
# -----------------------------------------------------------------------------
ADMIN_BOOTSTRAP_TOKEN=change-me-to-a-random-token

# -----------------------------------------------------------------------------
# CORS — comma-separated list of allowed origins
# -----------------------------------------------------------------------------
ALLOWED_ORIGINS=http://localhost:3001

# -----------------------------------------------------------------------------
# AWS (production only)
# -----------------------------------------------------------------------------
AWS_REGION=us-east-1
AWS_SECRET_NAME=qalnet/production/secrets

# Server port
PORT=3000
