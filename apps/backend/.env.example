# =============================================================================
# QalNet Backend — Environment Variables Example
# =============================================================================
# Copy this file to .env and fill in your actual values.
# This file is safe to commit — it contains NO real secrets.
# =============================================================================

# Database (Neon PostgreSQL)
# Get your connection string from: https://console.neon.tech
DATABASE_URL="postgresql://user:password@ep-xxxx-xxxx.region.aws.neon.tech/neondb?sslmode=require"

# Authentication Keys
# Generate with: openssl rand -hex 32
JWT_PRIVATE_KEY="your_jwt_private_key_min_32_chars"
JWT_PUBLIC_KEY="your_jwt_public_key_min_32_chars"
ARGON2_PEPPER="your_argon2_pepper_secret"
PGCRYPTO_SYMMETRIC_KEY="your_pgcrypto_symmetric_key"
ADMIN_BOOTSTRAP_TOKEN="your_admin_bootstrap_token"

# Services
REDIS_URL="redis://localhost:6379"

# CORS — comma-separated list of frontend origins allowed to call this API
ALLOWED_ORIGINS="http://localhost:3000,http://localhost:3001,http://localhost:5173"

# Payment Gateways
# Chapa: https://dashboard.chapa.co
CHAPA_SECRET_KEY="CHASECK_TEST-your_test_key_here"
# Telebirr: https://developer.ethiotelecom.et
TELEBIRR_APP_KEY="your_telebirr_app_key"
TELEBIRR_APP_SECRET="your_telebirr_app_secret"

# Tier 3 — Provider mode
# sandbox (default): mock gateways — no real money, safe for development.
# live:              real Chapa/Telebirr collection and real disbursement
#                    (ONLY after merchant accounts + production credentials).
PAYMENT_MODE="sandbox"
PAYOUT_MODE="sandbox"

# Tier 3 — Cron schedules (cron expressions, UTC)
# Payout disbursement (default: every day 07:00 UTC / 10:00 EAT)
PAYOUT_CRON="0 7 * * *"
# Nightly reconciliation (default: every day 01:00 UTC / 04:00 EAT)
RECONCILIATION_CRON="0 1 * * *"
# Pending payments older than this many days are flagged as missing
RECONCILIATION_STALE_DAYS="2"

# SMS (AfricasTalking) — for OTP verification codes
# Dashboard: https://account.africastalking.com  →  SMS → Sandbox (test) or Liveliness (live)
# Leave AT_API_KEY empty to keep the dev fallback (OTP returned as dev_otp).
# Sandbox delivers only to phone numbers registered in the sandbox dashboard;
# use a live API key (and a registered sender ID/short code) for real numbers.
AT_USERNAME="sandbox"
AT_API_KEY="your_africastalking_api_key"
AT_SENDER_ID="QALNET"

# Universal developer OTP (temporary)
# Accepted for ANY phone number in non-production environments so registering
# customers can verify without an SMS until government/registration approval
# is granted. Never honoured in production. Default is 818959.
DEV_OTP="818959"

# Real Fayda eSignet OIDC integration (verification with a real Fayda OTP)
# FAYDA_MODE=sandbox (default): mock flow, no network — usable without keys.
# FAYDA_MODE=live: real eSignet calls; requires FAYDA_CLIENT_ID, FAYDA_PRIVATE_KEY
# and a registered FAYDA_REDIRECT_URI. The citizen authenticates with their FIN
# and a REAL OTP delivered by the Fayda system (eSignet test OTP is "111111").
# Client credentials come from the National ID Program relying-party portal.
# Private key = base64-encoded JWK (RSA) used to sign the client assertion (RS256).
FAYDA_MODE="sandbox"
FAYDA_ENABLED="false"
FAYDA_AUTHORIZATION_ENDPOINT="https://esignet.ida.fayda.et/authorize"
FAYDA_TOKEN_ENDPOINT="https://esignet.ida.fayda.et/v1/esignet/oauth/v2/token"
FAYDA_USERINFO_ENDPOINT="https://esignet.ida.fayda.et/v1/esignet/oidc/userinfo"
FAYDA_CLIENT_ID="your_esignet_client_id"
FAYDA_PRIVATE_KEY="base64_encoded_jwk_rsa_private_key"
FAYDA_REDIRECT_URI="http://localhost:3001/auth/fayda/callback"
FAYDA_SCOPES="openid profile"
