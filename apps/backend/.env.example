# =============================================================================
# QalNet Backend — Environment Variables Example
# =============================================================================
# Copy this file to .env and fill in your actual values.
# This file is safe to commit — it contains NO real secrets.
# =============================================================================

# Database (Neon PostgreSQL)
# Get your connection string from: https://console.neon.tech
DATABASE_URL="postgresql://user:password@ep-xxxx-xxxx.region.aws.neon.tech/neondb?sslmode=require"

# Authentication Keys
# Generate with: openssl rand -hex 32
JWT_PRIVATE_KEY="your_jwt_private_key_min_32_chars"
JWT_PUBLIC_KEY="your_jwt_public_key_min_32_chars"
ARGON2_PEPPER="your_argon2_pepper_secret"
PGCRYPTO_SYMMETRIC_KEY="your_pgcrypto_symmetric_key"
ADMIN_BOOTSTRAP_TOKEN="your_admin_bootstrap_token"

# Services
REDIS_URL="redis://localhost:6379"

# CORS — comma-separated list of frontend origins allowed to call this API
ALLOWED_ORIGINS="http://localhost:3000,http://localhost:3001,http://localhost:5173"

# Payment Gateways
# Chapa: https://dashboard.chapa.co
CHAPA_SECRET_KEY="CHASECK_TEST-your_test_key_here"
# Telebirr: https://developer.ethiotelecom.et
TELEBIRR_APP_KEY="your_telebirr_app_key"
TELEBIRR_APP_SECRET="your_telebirr_app_secret"

# SMS (AfricasTalking) — for OTP verification codes
# Dashboard: https://account.africastalking.com  →  SMS → Sandbox (test) or Liveliness (live)
# Leave AT_API_KEY empty to keep the dev fallback (OTP returned as dev_otp).
# Sandbox delivers only to phone numbers registered in the sandbox dashboard;
# use a live API key (and a registered sender ID/short code) for real numbers.
AT_USERNAME="sandbox"
AT_API_KEY="your_africastalking_api_key"
AT_SENDER_ID="QALNET"

# Universal developer OTP (temporary)
# Accepted for ANY phone number in non-production environments so registering
# customers can verify without an SMS until government/registration approval
# is granted. Never honoured in production. Default is 818959.
DEV_OTP="818959"
