{
    "name": "@qalnet/backend",
    "version": "1.0.0",
    "description": "QalNet Enterprise Backend — NestJS API",
    "author": "QalNet Engineering",
    "private": true,
    "license": "UNLICENSED",
    "scripts": {
        "build": "nest build",
        "dev": "nest start --watch",
        "start": "nest start",
        "start:debug": "nest start --debug --watch",
        "start:prod": "node dist/main",
        "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
        "type-check": "tsc --noEmit",
        "test": "jest",
        "test:watch": "jest --watch",
        "test:cov": "jest --coverage",
        "test:e2e": "jest --config ./test/jest-e2e.json --runInBand",
        "clean": "rimraf dist"
    },
    "dependencies": {
        "@aws-sdk/client-secrets-manager": "^3.540.0",
        "@nestjs/common": "^11.1.29",
        "@nestjs/config": "^4.0.4",
        "@nestjs/core": "^11.1.18",
        "@nestjs/jwt": "^11.0.0",
        "@nestjs/passport": "^11.0.5",
        "@nestjs/platform-express": "^11.1.29",
        "@nestjs/schedule": "^6.1.3",
        "@nestjs/swagger": "^11.4.6",
        "@qalnet/shared-types": "*",
        "argon2": "^0.31.2",
        "class-transformer": "^0.5.1",
        "class-validator": "^0.14.1",
        "cookie-parser": "^1.4.6",
        "dotenv": "^16.4.5",
        "ioredis": "^5.3.2",
        "otplib": "^13.4.1",
        "passport": "^0.7.0",
        "passport-jwt": "^4.0.1",
        "pg": "^8.11.5",
        "postgres": "^3.4.4",
        "redlock": "^4.2.0",
        "reflect-metadata": "^0.2.1",
        "rxjs": "^7.8.1",
        "typeorm": "^1.1.0",
        "uuid": "^14.0.0"
    },
    "devDependencies": {
        "@nestjs/cli": "^11.0.24",
        "@nestjs/schematics": "^11.1.0",
        "@nestjs/testing": "^11.1.29",
        "@qalnet/typescript-config": "*",
        "@types/cookie-parser": "^1.4.7",
        "@types/express": "^5.0.6",
        "@types/jest": "^29.5.14",
        "@types/node": "^20.11.30",
        "@types/otplib": "^7.0.0",
        "@types/passport-jwt": "^4.0.1",
        "@types/pg": "^8.11.4",
        "@types/redlock": "^4.0.7",
        "@types/supertest": "^7.2.1",
        "@types/uuid": "^9.0.8",
        "@typescript-eslint/eslint-plugin": "^7.3.1",
        "@typescript-eslint/parser": "^7.3.1",
        "eslint": "^8.57.0",
        "jest": "^29.7.0",
        "rimraf": "^5.0.10",
        "supertest": "^7.2.2",
        "ts-jest": "^29.1.2",
        "ts-node": "^10.9.2",
        "typescript": "^5.4.2"
    },
    "jest": {
        "moduleFileExtensions": [
            "js",
            "json",
            "ts"
        ],
        "rootDir": "src",
        "testRegex": ".*\\.spec\\.ts$",
        "transform": {
            "^.+\\.(t|j)s$": "ts-jest"
        },
        "collectCoverageFrom": [
            "**/*.(t|j)s"
        ],
        "coverageDirectory": "../../coverage/backend",
        "testEnvironment": "node",
        "moduleNameMapper": {
            "^@common/(.*)$": "<rootDir>/common/$1",
            "^@config/(.*)$": "<rootDir>/config/$1",
            "^@modules/(.*)$": "<rootDir>/modules/$1"
        }
    }
}
