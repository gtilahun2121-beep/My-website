{
    "name": "qalnet",
    "version": "1.0.0",
    "private": true,
    "description": "QalNet — Digital Equb Platform Monorepo",
    "workspaces": [
        "apps/*",
        "packages/*"
    ],
    "scripts": {
        "build": "turbo build",
        "predev": "node scripts/kill-ports.cjs",
        "dev": "turbo dev",
        "dev:restart": "node scripts/dev.cjs",
        "lint": "turbo lint",
        "test": "turbo test",
        "type-check": "turbo type-check",
        "clean": "turbo clean && rimraf node_modules",
        "format": "prettier --write \"**/*.{ts,tsx,js,json,md}\"",
        "pm2:start": "npm run build && pm2 start ecosystem.config.cjs && pm2 save",
        "pm2:start:quick": "pm2 start ecosystem.config.cjs",
        "pm2:status": "pm2 status",
        "pm2:logs": "pm2 logs qalnet-backend qalnet-web",
        "pm2:restart": "pm2 restart ecosystem.config.cjs",
        "pm2:stop": "pm2 stop ecosystem.config.cjs",
        "pm2:delete": "pm2 delete ecosystem.config.cjs"
    },
    "devDependencies": {
        "lightningcss-win32-x64-msvc": "^1.32.0",
        "pm2": "^7.0.3",
        "prettier": "^3.3.3",
        "rimraf": "^5.0.10",
        "turbo": "^2.10.8",
        "typescript": "^5.4.2"
    },
    "engines": {
        "node": ">=20.0.0",
        "npm": ">=10.0.0"
    },
    "overrides": {
        "@nestjs/swagger": {
            "js-yaml": "^5.2.3"
        }
    },
    "packageManager": "npm@10.9.2",
    "dependencies": {
        "cors": "^2.8.6",
        "express": "^5.2.1",
        "jsonwebtoken": "^9.0.0"
    }
}
