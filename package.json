{
    "name": "qalnet",
    "version": "1.0.0",
    "private": true,
    "description": "QalNet — Digital Equb Platform Monorepo",
    "workspaces": [
        "apps/*",
        "packages/*"
    ],
    "scripts": {
        "build": "turbo build",
        "dev": "turbo dev",
        "dev:restart": "node scripts/dev.cjs",
        "lint": "turbo lint",
        "test": "turbo test",
        "type-check": "turbo type-check",
        "clean": "turbo clean && rimraf node_modules",
        "format": "prettier --write \"**/*.{ts,tsx,js,json,md}\""
    },
    "devDependencies": {
        "lightningcss-win32-x64-msvc": "^1.32.0",
        "prettier": "^3.3.3",
        "rimraf": "^5.0.10",
        "turbo": "^2.10.8",
        "typescript": "^5.4.2"
    },
    "engines": {
        "node": ">=20.0.0",
        "npm": ">=10.0.0"
    },
    "packageManager": "npm@10.9.2"
}
