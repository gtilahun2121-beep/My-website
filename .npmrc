# ── Network resilience ─────────────────────────────────────────────────────
# Prevent ECONNRESET / EPERM install failures on flaky or proxied networks.
fetch-retries=5
fetch-retry-mintimeout=20000
fetch-retry-maxtimeout=120000
fetch-timeout=600000
prefer-online=true

# ── Speed / less network chatter ───────────────────────────────────────────
audit=false
fund=false
