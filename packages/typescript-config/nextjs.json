{
    "extends": "./base.json",
    "compilerOptions": {
        "target": "ES2020",
        "lib": [
            "dom",
            "dom.iterable",
            "esnext"
        ],
        "allowJs": true,
        "noEmit": true,
        "module": "esnext",
        "moduleResolution": "bundler",
        "isolatedModules": true,
        "jsx": "react-jsx",
        "incremental": true,
        "skipDefaultLibCheck": true,
        "plugins": [
            {
                "name": "next"
            }
        ]
    }
}