# QalNet Production Environment Configuration
# Copy this file to .env and fill with real values
# DO NOT commit .env to version control

# ==========================================
# CORE APPLICATION CONFIGURATION
# ==========================================

# Node environment
NODE_ENV=production

# Server configuration
PORT=4000
HOST=0.0.0.0

# ==========================================
# SECURITY
# ==========================================

# JWT Secrets - Generate with OpenSSL:
# openssl genrsa -out private.pem 2048
# openssl rsa -in private.pem -pubout -out public.pem
JWT_PRIVATE_KEY=-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----
JWT_PUBLIC_KEY=-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----

# JWT secret for HMAC (alternative to RSA keys)
JWT_SECRET=your-strong-random-jwt-secret-here-min-32-chars-long

# Argon2 pepper for password hashing
ARGON2_PEPPER=your-random-pepper-string-32-chars-min

# ==========================================
# DATABASE CONFIGURATION
# ==========================================

# Full database connection URL (PostgreSQL required for production)
# Format: postgresql://user:password@host:port/database
DATABASE_URL=postgresql://qalnet_app:strong-password@db.example.com:5432/qalnet_production

# Alternative: Individual database settings
DB_TYPE=postgresql
DB_HOST=db.example.com
DB_PORT=5432
DB_NAME=qalnet_production
DB_USER=qalnet_app
DB_PASSWORD=your-strong-database-password

# ==========================================
# REDIS CONFIGURATION (Required for Redlock)
# ==========================================

# Redis connection URL
REDIS_URL=redis://:password@redis.example.com:6379

# ==========================================
# PAYMENT INTEGRATION - CHAPA
# ==========================================

# Chapa Payment Gateway Integration
# Sign up at https://chapa.co and get API keys from Settings → API Keys

# Your Chapa Public Key (shared, safe to expose)
CHAPA_PUBLIC_KEY=CHAPUBK_your-actual-public-key-here

# Your Chapa Secret Key (KEEP SECURE - Never commit to Git!)
# Test token: CHASECK_TEST-JXfelzS59KnCESAXpB390yHrLqG1k5tF
# Production: Get from Chapa dashboard after account verification
CHAPA_SECRET_KEY=CHASECK_your-production-secret-key-here

# Chapa API endpoints (usually no need to change)
CHAPA_API_BASE=https://api.chapa.co/v1
CHAPA_CHECKOUT_BASE=https://checkout.chapa.co/checkout/payment

# Chapa webhook secret for signature verification
CHAPA_WEBHOOK_SECRET=your-webhook-secret-from-chapa-dashboard

# ==========================================
# PAYMENT INTEGRATION - TELEBIRR
# ==========================================

# Telebirr Payment Gateway Integration
# Register at https://developer.ethiotelecom.et for merchant account

# Telebirr App ID / Merchant ID
TELEBIRR_APP_KEY=your-telebirr-app-id-from-developer-portal

# Telebirr App Secret (KEEP SECURE - Never commit to Git!)
TELEBIRR_APP_SECRET=your-telebirr-app-secret-from-developer-portal

# Telebirr API endpoints
TELEBIRR_API_BASE=https://pay.telebirr.et
TELEBIRR_CHECKOUT_BASE=https://telebirr.et/checkout

# ==========================================
# AWS CONFIGURATION (For Secrets Manager)
# ==========================================

# If using AWS Secrets Manager in production (recommended)
AWS_REGION=us-east-1
AWS_SECRET_NAME=qalnet/production/secrets
AWS_ACCESS_KEY_ID=your-aws-access-key
AWS_SECRET_ACCESS_KEY=your-aws-secret-access-key

# ==========================================
# FRONTEND CONFIGURATION
# ==========================================

# Frontend URL (for CORS and redirects)
FRONTEND_URL=https://qalnet.example.com

# Next.js specific (if using Next.js frontend)
NEXT_PUBLIC_API_URL=https://api.qalnet.example.com
NEXT_PUBLIC_APP_NAME=QalNet

# ==========================================
# ADMIN ACCOUNT BOOTSTRAP
# ==========================================

# One-time bootstrap token for creating first admin (use only once)
ADMIN_BOOTSTRAP_TOKEN=your-secure-one-time-bootstrap-token

# ==========================================
# WALLET CONFIGURATION
# ==========================================

# Initial wallet balance for new users (in ETB)
INITIAL_WALLET_BALANCE=0

# Minimum deposit amount (in ETB)
MIN_DEPOSIT=100

# Maximum daily withdrawal (in ETB)
MAX_DAILY_WITHDRAWAL=100000

# ==========================================
# EQUB CONFIGURATION
# ==========================================

# Default equb tiers (amounts in ETB)
EQUB_DAILY_AMOUNT=300
EQUB_WEEKLY_AMOUNT=2000
EQUB_MONTHLY_AMOUNT=10000

# ==========================================
# LOGGING & MONITORING
# ==========================================

# Log level: debug, info, warn, error
LOG_LEVEL=info

# Sentry error tracking (optional)
SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id

# Enable request logging
LOG_REQUESTS=true

# ==========================================
# EMAIL CONFIGURATION (Optional)
# ==========================================

# Email provider: sendgrid, mailgun, smtp
EMAIL_PROVIDER=sendgrid
SENDGRID_API_KEY=SG.xxxxxxxxxxxxxxxxxxxxxxxxxxxx
EMAIL_FROM=noreply@qalnet.com

# Or SMTP configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password

# ==========================================
# SMS CONFIGURATION (Optional)
# ==========================================

# SMS provider: ethiosms, nexmo, twilio
SMS_PROVIDER=ethiosms
ETHIOSMS_API_KEY=your-ethiosms-api-key
SMS_FROM=QalNet

# Or Twilio
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_PHONE_NUMBER=+1234567890

# ==========================================
# FEATURE FLAGS
# ==========================================

# Enable/disable payment providers
FEATURE_TELEBIRR=true
FEATURE_CHAPA=true

# Enable/disable notifications
FEATURE_EMAIL_NOTIFICATIONS=false
FEATURE_SMS_NOTIFICATIONS=true

# Enable/disable admin dashboard
FEATURE_ADMIN_DASHBOARD=true

# ==========================================
# RATE LIMITING
# ==========================================

# Request rate limits (requests per minute)
RATE_LIMIT_GENERAL=60
RATE_LIMIT_AUTH=5
RATE_LIMIT_PAYMENT=10

# ==========================================
# SESSION & SECURITY
# ==========================================

# Session timeout (seconds) - 24 hours
SESSION_TIMEOUT=86400

# Password requirements
MIN_PASSWORD_LENGTH=8
MIN_PIN_LENGTH=4
MAX_PIN_LENGTH=6

# ==========================================
# STORAGE CONFIGURATION
# ==========================================

# AWS S3 for file storage
AWS_BUCKET_NAME=qalnet-production
STORAGE_PROVIDER=s3

# ==========================================
# DEVELOPMENT/TESTING (Disable in Production!)
# ==========================================

# Allow test payment endpoints (only in test/staging)
ALLOW_TEST_PAYMENTS=false

# Mock payment responses (only in development)
MOCK_PAYMENTS=false

# Debug mode (only in development)
DEBUG=false

# ==========================================
# CORS CONFIGURATION
# ==========================================

# Allowed origins (comma-separated)
CORS_ORIGINS=https://qalnet.example.com,https://www.qalnet.example.com

# Allow credentials in CORS
CORS_CREDENTIALS=true

# ==========================================
# API DOCUMENTATION
# ==========================================

# API Documentation
API_DOCS_ENABLED=true
API_DOCS_URL=/api/docs

# Health check endpoint
HEALTH_CHECK_ENABLED=true
HEALTH_CHECK_URL=/api/v1/health
