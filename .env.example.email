# =========================================================================
# EMAIL CONFIGURATION
# =========================================================================

# Email Provider: 'console', 'sendgrid', 'mailgun', 'smtp'
# Default: 'console' (prints to console for development)
EMAIL_PROVIDER=console

# Email Sender Configuration
EMAIL_FROM=noreply@qalnet.app
EMAIL_FROM_NAME=QalNet

# SendGrid Configuration
# Get API key from https://app.sendgrid.com/settings/api_keys
EMAIL_API_KEY=SG.xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Mailgun Configuration
# Get API key from https://app.mailgun.com/app/account/security/api_keys
EMAIL_API_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxx
MAILGUN_DOMAIN=mail.qalnet.app

# SMTP Configuration (for third-party email services)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-specific-password

# Application URL (for email links)
APP_URL=https://qalnet.app

# Email Feature Flags
ENABLE_EMAIL_NOTIFICATIONS=true
ENABLE_MEMBER_INVITATIONS=true
ENABLE_PAYMENT_NOTIFICATIONS=true
ENABLE_DRAW_NOTIFICATIONS=true
ENABLE_KYC_NOTIFICATIONS=true

# =========================================================================
# SETUP INSTRUCTIONS
# =========================================================================

# 1. CONSOLE MODE (Development - Default)
#    No setup needed. Emails print to console.
#    EMAIL_PROVIDER=console

# 2. SENDGRID (Production Recommended)
#    a) Create SendGrid account: https://sendgrid.com/
#    b) Generate API key from Settings > API Keys
#    c) Set: EMAIL_PROVIDER=sendgrid
#    d) Set: EMAIL_API_KEY=SG.xxxxx
#    e) Add verified sender email

# 3. MAILGUN (Production Alternative)
#    a) Create Mailgun account: https://mailgun.com/
#    b) Add and verify domain
#    c) Generate API key
#    d) Set: EMAIL_PROVIDER=mailgun
#    e) Set: EMAIL_API_KEY=xxxx
#    f) Set: MAILGUN_DOMAIN=your-domain

# 4. SMTP (Self-hosted)
#    a) Configure SMTP server credentials
#    b) Set: EMAIL_PROVIDER=smtp
#    c) Provide host, port, user, pass

# =========================================================================
# NPM PACKAGES TO INSTALL (Optional)
# =========================================================================

# For SendGrid:
# npm install @sendgrid/mail

# For Mailgun:
# npm install mailgun.js

# For SMTP:
# npm install nodemailer

# =========================================================================
# EMAIL TEMPLATES
# =========================================================================

# The following email templates are automatically sent:
# - member_invitation: When host invites member
# - invitation_accepted: When member accepts invitation
# - invitation_rejected: When member rejects invitation
# - member_removed: When member is removed from equb
# - member_left: When member leaves equb
# - payment_received: When payment confirmed
# - payment_failed: When payment fails
# - draw_result: When lottery draw completes
# - payout_processed: When payout is sent
# - kyc_verified: When KYC is verified
# - kyc_rejected: When KYC is rejected
# - welcome: Welcome email to new users
